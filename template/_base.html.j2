{% set short = name.split(' ')[-2:]|join(' ') %}
<!DOCTYPE html>
<html lang="vi">
<!-- Mã nguồn website được xây dựng với sự hỗ trợ của Claude (Anthropic). Chi tiết: README.md trong kho mã nguồn. -->
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}Portfolio{% endblock %} – {{ name }}</title>
<meta name="description" content="{{ short_bio }}">
<meta name="theme-color" content="#f8f3ec">
<link rel="preload" href="assets/fonts/cormorant-garamond-vietnamese-500-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="assets/style.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='32' fill='%232a1f2f'/><ellipse cx='27' cy='42' rx='9' ry='6.5' transform='rotate(-20 27 42)' fill='%23e9cfae'/><rect x='34' y='14' width='3.5' height='28' fill='%23e9cfae'/><path d='M37.5 14q10 4 8 14' fill='none' stroke='%23e9cfae' stroke-width='3'/></svg>">
</head>
<body class="p-{{ page }}">
<a class="skip" href="#main">Bỏ qua đến nội dung</a>

<aside class="rail" id="rail">
  <div class="rail-in">
    <a href="index.html" class="seal" aria-label="Trang chủ – {{ name }}">
      <span class="seal-mono" aria-hidden="true">{{ name.split(' ')[-2][0] }}<i>{{ name.split(' ')[-1][0] }}</i></span>
      <span class="seal-txt"><b>{{ short }}</b><em>Vocal · Sư phạm</em></span>
    </a>

    <p class="rail-label">Chương trình</p>
    <nav class="rail-nav" aria-label="Chính">
      <a href="index.html"{{ ' aria-current=page' if page == 'home' }}><span class="rn">I</span><span><b>Giới thiệu</b><em>Prélude</em></span></a>
      <a href="projects.html"{{ ' aria-current=page' if page == 'projects' and project is not defined }}><span class="rn">II</span><span><b>Dự án</b><em>Programme</em></span></a>
      <ol class="rail-sub">
        {% for pp in projects %}<li><a href="project-{{ pp.id }}.html"{{ ' aria-current=page' if project is defined and project.id == pp.id }}><span>{{ pp.id|roman }}.</span>{{ pp.title }}</a></li>{% endfor %}
      </ol>
      <a href="conclusion.html"{{ ' aria-current=page' if page == 'conclusion' }}><span class="rn">III</span><span><b>Tổng kết</b><em>Coda</em></span></a>
    </nav>

    <div class="rail-foot">
      <button class="snd" type="button" id="sndBtn" aria-pressed="true"><span class="snd-bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="snd-t">Âm thanh: bật</span></button>
      <p class="rail-meta">INF2501 · {{ major }}</p>
    </div>
  </div>
</aside>

<header class="mbar">
  <a href="index.html" class="seal seal-sm" aria-label="Trang chủ"><span class="seal-mono" aria-hidden="true">{{ name.split(' ')[-2][0] }}<i>{{ name.split(' ')[-1][0] }}</i></span><span class="seal-txt"><b>{{ short }}</b></span></a>
  <button class="mbtn" type="button" aria-controls="rail" aria-expanded="false"><span></span><span></span><span></span><b class="vh">Mở menu</b></button>
</header>
<div class="scrim" aria-hidden="true"></div>

<div class="stage">
<main id="main">
{% block content %}{% endblock %}
</main>

<footer class="curtain-foot">
  <div class="keys" aria-hidden="true">
    {% set kb = [0,2,4,5,7,9,11,12,14,16,17,19,21,23,24] %}
    {% for s in kb %}<i class="wk" data-semi="{{ s }}"></i>{% endfor %}
    {% for s in [1,3,6,8,10,13,15,18,20,22] %}<i class="bk" data-semi="{{ s }}" style="--x:{{ {1:1,3:2,6:4,8:5,10:6,13:8,15:9,18:11,20:12,22:13}[s] }}"></i>{% endfor %}
  </div>
  <div class="foot-in">
    <div>
      <p class="foot-big">Hạ màn — <em>cảm ơn bạn đã lắng nghe.</em></p>
      <p class="foot-hint">Rê chuột (hoặc chạm) lên phím đàn phía trên để chơi thử.</p>
    </div>
    <dl class="foot-info">
      <div><dt>Sinh viên</dt><dd>{{ name }}</dd></div>
      <div><dt>Mã sinh viên</dt><dd>{{ student_id or 'đang cập nhật' }}</dd></div>
      <div><dt>Lớp</dt><dd>{{ class or 'đang cập nhật' }}</dd></div>
      <div><dt>Ngành</dt><dd>{{ major }}</dd></div>
      <div><dt>Học phần</dt><dd>{{ subject }}</dd></div>
    </dl>
  </div>
  <p class="foot-end"><span>{{ school }}</span><span>Portfolio · INF2501</span></p>
</footer>
</div>
<script src="assets/main.js"></script>
</body>
</html>
