{% extends "_base.html.j2" %}
{% block title %}Dự án{% endblock %}
{% block content %}
<section class="page-head">
  <div class="sec-in narrow center">
    <p class="eyebrow">Programme · Sáu tiết mục</p>
    <h1 class="h1">Chương trình <em>biểu diễn</em></h1>
    <p class="sec-sub">Sáu bài tập ứng với sáu chương của học phần, in như tờ chương trình của một buổi hòa nhạc. Rê chuột lên từng tiết mục để nghe nốt mở màn, bấm để vào xem.</p>
    <div class="flourish" aria-hidden="true"><i></i><span>❦</span><i></i></div>
  </div>
</section>

<section class="sec-in narrow">
  {% set scale = [0, 2, 4, 5, 7, 9] %}
  <ol class="programme">
    {% for p in projects %}
    {% set done = not (p.objective is blank) %}
    <li>
      <a class="pg{{ ' is-todo' if not done }}" href="project-{{ p.id }}.html" data-semi="{{ scale[loop.index0 % 6] }}">
        <span class="pg-no">{{ p.id|roman }}.</span>
        <span class="pg-main">
          <span class="pg-title">{{ p.title }}</span>
          <span class="pg-ch">{{ p.chapter }}</span>
        </span>
        <span class="pg-dots" aria-hidden="true"></span>
        <span class="pg-sec">Bài {{ p.section }}</span>
        <span class="pg-state">{{ 'Đã biểu diễn' if done else 'Sắp biểu diễn' }}</span>
      </a>
    </li>
    {% endfor %}
  </ol>
  <p class="intermission"><span>Giải lao</span> — các tiết mục sẽ lần lượt được cập nhật trong suốt học phần.</p>
</section>
{% endblock %}
